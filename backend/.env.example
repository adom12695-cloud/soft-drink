PORT=5000
MONGO_URI=mongodb://localhost:27017/softdrink_db
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=7d
NODE_ENV=development

# ── Email — Option A: Gmail OAuth2 (recommended for production/Render) ────────
# Gmail SMTP is blocked on cloud providers. OAuth2 uses HTTPS — works everywhere.
# Setup guide: https://developers.google.com/gmail/api/quickstart/nodejs
#
# 1. Go to https://console.cloud.google.com → New Project
# 2. Enable "Gmail API"
# 3. Create OAuth2 credentials (Desktop app type)
# 4. Use OAuth2 Playground (https://developers.google.com/oauthplayground):
#    - Gear icon → check "Use your own OAuth credentials" → paste Client ID + Secret
#    - Authorize "https://mail.google.com/"
#    - Exchange auth code for tokens → copy Refresh Token
GMAIL_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=your_google_client_secret
GMAIL_REFRESH_TOKEN=your_refresh_token
EMAIL_USER=your_gmail@gmail.com
EMAIL_FROM="SoftDrink Distribution <your_gmail@gmail.com>"

# ── Email — Option B: Generic SMTP (works locally, blocked on Render free tier) 
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_SECURE=false
# EMAIL_USER=your_gmail@gmail.com
# EMAIL_PASS=your_16_char_app_password
# EMAIL_FROM="SoftDrink Distribution <your_gmail@gmail.com>"

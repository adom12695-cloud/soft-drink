PORT=5000
MONGO_URI=mongodb://localhost:27017/softdrink_db
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=7d
NODE_ENV=development

# ── Email (Nodemailer) ────────────────────────────────────────────────────────
# Gmail SMTP is blocked on Render free tier (cloud IP firewall).
# Use Brevo free SMTP instead — 300 emails/day, no credit card needed.
#
# Setup (2 min):
#   1. Sign up at https://app.brevo.com
#   2. Go to SMTP & API → SMTP tab → copy login + master password
#   3. Paste below

EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your_brevo_login_email
EMAIL_PASS=your_brevo_smtp_password
EMAIL_FROM="SoftDrink Distribution <your_brevo_login_email>"
